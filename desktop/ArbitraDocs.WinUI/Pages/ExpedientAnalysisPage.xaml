<Page
    x:Class="ArbitraDocs.WinUI.Pages.ExpedientAnalysisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Analizar expediente" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Detecta contratos, fechas, cláusulas arbitrales y comprobantes. Aplica OCR automáticamente solo a las páginas que lo necesitan."
                TextWrapping="Wrap"
                Opacity="0.72" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="DropZone"
                Padding="16"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                AllowDrop="True"
                DragOver="DropZone_DragOver"
                Drop="DropZone_Drop">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8B7;" FontSize="28" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="Escrito + anexos" FontWeight="SemiBold" />
                        <TextBlock x:Name="SourceText" Text="Arrastra aquí una carpeta, ZIP, RAR o PDF" TextTrimming="CharacterEllipsis" Opacity="0.68" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Content="Archivo" Click="SelectFile_Click" />
                        <Button Content="Carpeta" Click="SelectFolder_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="14"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Guardar resultados en" FontWeight="SemiBold" />
                    <TextBlock x:Name="OutputFolderText" Text="Selecciona una carpeta de salida" TextTrimming="CharacterEllipsis" Opacity="0.68" />
                    <Button Content="Elegir carpeta de salida" HorizontalAlignment="Left" Click="SelectOutputFolder_Click" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button
                    x:Name="AnalyzeButton"
                    Content="Analizar expediente"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="Analyze_Click" />
                <Button
                    x:Name="OpenResultsButton"
                    Content="Abrir carpeta de resultados"
                    IsEnabled="False"
                    Click="OpenResults_Click" />
                <ProgressRing x:Name="BusyRing" IsActive="False" Visibility="Collapsed" Width="24" Height="24" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel><TextBlock Text="Archivos revisados" Opacity="0.65" /><TextBlock x:Name="DocumentsCountText" Text="0" FontSize="22" FontWeight="SemiBold" /></StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel><TextBlock Text="Páginas revisadas" Opacity="0.65" /><TextBlock x:Name="PagesCountText" Text="0" FontSize="22" FontWeight="SemiBold" /></StackPanel>
                </Border>
                <Border Grid.Column="2" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel><TextBlock Text="OCR aplicado" Opacity="0.65" /><TextBlock x:Name="OcrCountText" Text="0" FontSize="22" FontWeight="SemiBold" /></StackPanel>
                </Border>
                <Border Grid.Column="3" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel><TextBlock Text="Contratos" Opacity="0.65" /><TextBlock x:Name="ContractsCountText" Text="0" FontSize="22" FontWeight="SemiBold" /></StackPanel>
                </Border>
                <Border Grid.Column="4" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel><TextBlock Text="Comprobantes" Opacity="0.65" /><TextBlock x:Name="PaymentsCountText" Text="0" FontSize="22" FontWeight="SemiBold" /></StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.35*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Padding="14" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Contratos detectados" FontSize="17" FontWeight="SemiBold" />
                        <ListView x:Name="ContractsList" Grid.Row="1" ItemsSource="{x:Bind Contracts}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,3" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SourcePath}" FontSize="12" Opacity="0.58" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="14">
                                                    <TextBlock><Run Text="Fecha: " /><Run Text="{Binding IssueDateText}" /></TextBlock>
                                                    <TextBlock><Run Text="Páginas: " /><Run Text="{Binding PagesText}" /></TextBlock>
                                                    <TextBlock><Run Text="Cláusula: " /><Run Text="{Binding ClausePagesText}" /></TextBlock>
                                                    <TextBlock><Run Text="Confianza: " /><Run Text="{Binding ConfidenceText}" /></TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                                <Button Content="Abrir contrato" Tag="{Binding OutputPdf}" Click="OpenGeneratedPdf_Click" />
                                                <Button Content="Abrir cláusula" Tag="{Binding ClausePdf}" Click="OpenGeneratedPdf_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Padding="14" CornerRadius="10" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="Comprobantes detectados" FontSize="17" FontWeight="SemiBold" />
                        <ListView x:Name="PaymentsList" Grid.Row="1" ItemsSource="{x:Bind Payments}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,3" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding SourcePath}" FontSize="12" Opacity="0.58" TextTrimming="CharacterEllipsis" />
                                                <TextBlock><Run Text="Página: " /><Run Text="{Binding Page}" /><Run Text=" · Fecha: " /><Run Text="{Binding DateText}" /></TextBlock>
                                                <TextBlock><Run Text="Importe: " /><Run Text="{Binding AmountText}" /><Run Text=" · Operación: " /><Run Text="{Binding OperationText}" /></TextBlock>
                                                <TextBlock><Run Text="Confianza: " /><Run Text="{Binding ConfidenceText}" /></TextBlock>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Abrir PDF" Tag="{Binding OutputPdf}" Click="OpenGeneratedPdf_Click" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <InfoBar x:Name="StatusBar" Grid.Row="3" IsOpen="False" IsClosable="True" />
        </Grid>
    </Grid>
</Page>
