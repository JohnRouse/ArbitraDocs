<Page
    x:Class="ArbitraDocs.WinUI.Pages.FileInventoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Mapear archivos" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Explora una carpeta, ZIP o RAR y obtén el árbol completo de carpetas, subcarpetas y archivos sin modificar el contenido original."
                TextWrapping="Wrap"
                Opacity="0.72" />
        </StackPanel>

        <Border
            x:Name="DropZone"
            Grid.Row="1"
            Padding="16"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            AllowDrop="True"
            DragOver="DropZone_DragOver"
            Drop="DropZone_Drop">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="Arrastra aquí una carpeta, ZIP o RAR" FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="SourceText"
                        Text="Ninguna fuente seleccionada"
                        TextTrimming="CharacterEllipsis"
                        Opacity="0.62" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Seleccionar carpeta" Click="SelectFolder_Click" />
                    <Button Content="Seleccionar ZIP/RAR" Click="SelectArchive_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Archivos" Opacity="0.62" />
                    <TextBlock x:Name="FilesCountText" Text="0" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Carpetas" Opacity="0.62" />
                    <TextBlock x:Name="FoldersCountText" Text="0" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Tamaño total" Opacity="0.62" />
                    <TextBlock x:Name="TotalSizeText" Text="0 B" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock Text="Extensiones distintas" Opacity="0.62" />
                    <TextBlock x:Name="ExtensionsCountText" Text="0" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3" ColumnSpacing="16" MinHeight="360">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="12"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Estructura" FontWeight="SemiBold" FontSize="16" />
                    <TreeView x:Name="InventoryTree" Grid.Row="1" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBox
                    x:Name="SearchBox"
                    Header="Buscar en el inventario"
                    PlaceholderText="Nombre, extensión o ruta..."
                    TextChanged="SearchBox_TextChanged" />

                <Border
                    Grid.Row="1"
                    Padding="12"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Resultados" FontWeight="SemiBold" />
                        <ListView Grid.Row="1" ItemsSource="{x:Bind SearchResults}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Path}" FontSize="11" Opacity="0.58" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="2"
                    Padding="12"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Tipos de archivo" FontWeight="SemiBold" />
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ExtensionSummary}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="3" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Extension}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Count}" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="4" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <ProgressRing x:Name="BusyRing" IsActive="False" Visibility="Collapsed" />
                <InfoBar x:Name="StatusBar" IsOpen="False" IsClosable="True" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="Exportar TXT" Click="ExportTxt_Click" IsEnabled="False" x:Name="ExportTxtButton" />
                <Button Content="Exportar CSV" Click="ExportCsv_Click" IsEnabled="False" x:Name="ExportCsvButton" />
                <Button Content="Exportar JSON" Click="ExportJson_Click" IsEnabled="False" x:Name="ExportJsonButton" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
