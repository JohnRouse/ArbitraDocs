<Page
    x:Class="ArbitraDocs.WinUI.Pages.MergeFolioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Unir y foliar PDF" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Ordena los archivos, decide cómo tratar las páginas A4 y configura la foliación." Opacity="0.72" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="DropZone"
                    Padding="18"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                    <StackPanel HorizontalAlignment="Center" Spacing="7">
                        <FontIcon Glyph="&#xE898;" FontSize="28" />
                        <TextBlock Text="Arrastra tus PDFs aquí" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="o usa Agregar PDF" Opacity="0.65" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ListView
                    x:Name="PdfList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind Files}"
                    SelectionMode="Single"
                    CanReorderItems="True"
                    AllowDrop="True">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,5" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEA90;" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}" FontSize="12" Opacity="0.58" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button Click="AddPdf_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Add" />
                            <TextBlock Text="Agregar PDF" />
                        </StackPanel>
                    </Button>
                    <Button Content="Quitar" Click="RemovePdf_Click" />
                    <Button Content="Subir" Click="MoveUp_Click" />
                    <Button Content="Bajar" Click="MoveDown_Click" />
                    <Button Content="Limpiar" Click="Clear_Click" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="14">
                    <Expander Header="Página A4" IsExpanded="True">
                        <StackPanel Padding="4,12,4,8" Spacing="12">
                            <ToggleSwitch x:Name="NormalizeToggle" Header="Convertir salida a A4 vertical" IsOn="True" />
                            <ToggleSwitch
                                x:Name="PreserveA4Toggle"
                                Header="Conservar A4 existente al 100 %"
                                IsOn="True"
                                IsEnabled="{Binding IsOn, ElementName=NormalizeToggle}" />
                            <NumberBox
                                x:Name="PageMarginBox"
                                Header="Margen de página (mm)"
                                Value="8"
                                Minimum="0"
                                Maximum="50"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                IsEnabled="{Binding IsOn, ElementName=NormalizeToggle}" />
                            <ToggleSwitch
                                x:Name="EnlargeSmallToggle"
                                Header="Ampliar páginas pequeñas para aprovechar el área disponible"
                                IsOn="False"
                                IsEnabled="{Binding IsOn, ElementName=NormalizeToggle}" />
                            <TextBlock
                                Text="Si 'Conservar A4 existente al 100 %' está desactivado, el margen elegido también se aplica a páginas que ya son A4."
                                TextWrapping="Wrap"
                                FontSize="12"
                                Opacity="0.62" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="Foliación" IsExpanded="True">
                        <StackPanel Padding="4,12,4,8" Spacing="12">
                            <ToggleSwitch x:Name="FoliateToggle" Header="Foliar documento final" IsOn="True" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox
                                    x:Name="StartNumberBox"
                                    Header="Número inicial"
                                    Value="1"
                                    Minimum="0"
                                    Maximum="999999999"
                                    SpinButtonPlacementMode="Compact"
                                    IsEnabled="{Binding IsOn, ElementName=FoliateToggle}" />
                                <ComboBox
                                    x:Name="DirectionCombo"
                                    Grid.Column="1"
                                    Header="Dirección"
                                    SelectedIndex="0"
                                    IsEnabled="{Binding IsOn, ElementName=FoliateToggle}">
                                    <ComboBoxItem Content="Ascendente" Tag="asc" />
                                    <ComboBoxItem Content="Descendente" Tag="desc" />
                                </ComboBox>
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="ModeCombo"
                                    Header="Formato"
                                    SelectedIndex="2"
                                    IsEnabled="{Binding IsOn, ElementName=FoliateToggle}">
                                    <ComboBoxItem Content="Número" Tag="numero" />
                                    <ComboBoxItem Content="Letras" Tag="letras" />
                                    <ComboBoxItem Content="Número + letras" Tag="numero+letras" />
                                </ComboBox>
                                <ComboBox
                                    x:Name="PositionCombo"
                                    Grid.Column="1"
                                    Header="Posición"
                                    SelectedIndex="2"
                                    IsEnabled="{Binding IsOn, ElementName=FoliateToggle}">
                                    <ComboBoxItem Content="Superior izquierda" Tag="top-left" />
                                    <ComboBoxItem Content="Superior centro" Tag="top-center" />
                                    <ComboBoxItem Content="Superior derecha" Tag="top-right" />
                                    <ComboBoxItem Content="Inferior izquierda" Tag="bottom-left" />
                                    <ComboBoxItem Content="Inferior centro" Tag="bottom-center" />
                                    <ComboBoxItem Content="Inferior derecha" Tag="bottom-right" />
                                </ComboBox>
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox
                                    x:Name="FontSizeBox"
                                    Header="Tamaño (pt)"
                                    Value="8"
                                    Minimum="5.5"
                                    Maximum="30"
                                    SmallChange="0.5"
                                    SpinButtonPlacementMode="Compact"
                                    IsEnabled="{Binding IsOn, ElementName=FoliateToggle}" />
                                <NumberBox
                                    x:Name="FolioMarginXBox"
                                    Grid.Column="1"
                                    Header="Margen H (mm)"
                                    Value="10"
                                    Minimum="0"
                                    Maximum="60"
                                    SpinButtonPlacementMode="Compact"
                                    IsEnabled="{Binding IsOn, ElementName=FoliateToggle}" />
                                <NumberBox
                                    x:Name="FolioMarginYBox"
                                    Grid.Column="2"
                                    Header="Margen V (mm)"
                                    Value="6"
                                    Minimum="0"
                                    Maximum="60"
                                    SpinButtonPlacementMode="Compact"
                                    IsEnabled="{Binding IsOn, ElementName=FoliateToggle}" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Button
                        x:Name="ProcessButton"
                        Content="Procesar PDF"
                        HorizontalAlignment="Stretch"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="ProcessButton_Click" />

                    <ProgressRing
                        x:Name="ProcessingRing"
                        IsActive="False"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center" />

                    <InfoBar
                        x:Name="StatusBar"
                        IsOpen="False"
                        IsClosable="True" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
