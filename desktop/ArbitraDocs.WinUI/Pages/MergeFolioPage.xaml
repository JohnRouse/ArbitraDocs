<Page
    x:Class="ArbitraDocs.WinUI.Pages.MergeFolioPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">

    <Grid Padding="28" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Text="Unir, foliar y certificar PDF" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Ordena los archivos, configura la salida, el formato A4, la foliación y la certificación al reverso." Opacity="0.72" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="0.78*" />
                <ColumnDefinition Width="0.54*" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="DropZone"
                    Padding="18"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    AllowDrop="True"
                    DragOver="DropZone_DragOver"
                    Drop="DropZone_Drop">
                    <StackPanel HorizontalAlignment="Center" Spacing="7">
                        <FontIcon Glyph="&#xE898;" FontSize="28" />
                        <TextBlock Text="Arrastra tus PDFs aquí" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="o usa Agregar PDF" Opacity="0.65" HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <ListView
                    x:Name="PdfList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind Files}"
                    SelectionMode="Single"
                    CanReorderItems="True"
                    AllowDrop="True">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,5" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEA90;" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}" FontSize="12" Opacity="0.58" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                    <Button Click="AddPdf_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Add" />
                            <TextBlock Text="Agregar PDF" />
                        </StackPanel>
                    </Button>
                    <Button Content="Quitar" Click="RemovePdf_Click" />
                    <Button Content="Subir" Click="MoveUp_Click" />
                    <Button Content="Bajar" Click="MoveDown_Click" />
                    <Button Content="Limpiar" Click="Clear_Click" />
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14" Padding="0,0,4,16">
                    <Expander Header="Resultado" IsExpanded="True">
                        <StackPanel Padding="4,12,4,8" Spacing="10">
                            <ComboBox
                                x:Name="OutputModeCombo"
                                Header="Resultado final"
                                SelectedIndex="0"
                                HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Unir en un solo PDF" Tag="joined" />
                                <ComboBoxItem Content="Guardar PDFs por separado" Tag="separate" />
                            </ComboBox>
                            <TextBlock
                                Text="En modo separado, cada archivo se procesa de forma independiente y conserva su propio documento de salida."
                                TextWrapping="Wrap"
                                FontSize="12"
                                Opacity="0.62" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="Página A4" IsExpanded="True">
                        <StackPanel Padding="4,12,4,8" Spacing="12">
                            <ToggleSwitch x:Name="NormalizeToggle" Header="Convertir salida a A4 vertical" IsOn="True" />
                            <ToggleSwitch
                                x:Name="PreserveA4Toggle"
                                Header="Conservar A4 existente al 100 %"
                                IsOn="True"
                                IsEnabled="{Binding IsOn, ElementName=NormalizeToggle}" />
                            <NumberBox
                                x:Name="PageMarginBox"
                                Header="Margen de página (mm)"
                                Value="8"
                                Minimum="0"
                                Maximum="50"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                IsEnabled="{Binding IsOn, ElementName=NormalizeToggle}" />
                            <ToggleSwitch
                                x:Name="EnlargeSmallToggle"
                                Header="Ampliar páginas pequeñas para aprovechar el área disponible"
                                IsOn="False"
                                IsEnabled="{Binding IsOn, ElementName=NormalizeToggle}" />
                            <TextBlock
                                Text="Si 'Conservar A4 existente al 100 %' está desactivado, el margen elegido también se aplica a páginas que ya son A4."
                                TextWrapping="Wrap"
                                FontSize="12"
                                Opacity="0.62" />
                        </StackPanel>
                    </Expander>

                    <Expander Header="Foliación" IsExpanded="True">
                        <StackPanel Padding="4,12,4,8" Spacing="12">
                            <ToggleSwitch
                                x:Name="FoliateToggle"
                                Header="Foliar documento final"
                                IsOn="True"
                                Toggled="PreviewToggle_Changed" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox
                                    x:Name="StartNumberBox"
                                    Header="Número inicial"
                                    Value="1"
                                    Minimum="0"
                                    Maximum="999999999"
                                    SpinButtonPlacementMode="Compact"
                                    IsEnabled="{Binding IsOn, ElementName=FoliateToggle}"
                                    ValueChanged="PreviewNumber_ValueChanged" />
                                <ComboBox
                                    x:Name="DirectionCombo"
                                    Grid.Column="1"
                                    Header="Dirección"
                                    SelectedIndex="0"
                                    IsEnabled="{Binding IsOn, ElementName=FoliateToggle}">
                                    <ComboBoxItem Content="Ascendente" Tag="asc" />
                                    <ComboBoxItem Content="Descendente" Tag="desc" />
                                </ComboBox>
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="ModeCombo"
                                    Header="Formato"
                                    SelectedIndex="2"
                                    IsEnabled="{Binding IsOn, ElementName=FoliateToggle}"
                                    SelectionChanged="PreviewSelection_Changed">
                                    <ComboBoxItem Content="Número" Tag="numero" />
                                    <ComboBoxItem Content="Letras" Tag="letras" />
                                    <ComboBoxItem Content="Número + letras" Tag="numero+letras" />
                                </ComboBox>
                                <ComboBox
                                    x:Name="PositionCombo"
                                    Grid.Column="1"
                                    Header="Posición"
                                    SelectedIndex="2"
                                    IsEnabled="{Binding IsOn, ElementName=FoliateToggle}"
                                    SelectionChanged="PreviewSelection_Changed">
                                    <ComboBoxItem Content="Superior izquierda" Tag="top-left" />
                                    <ComboBoxItem Content="Superior centro" Tag="top-center" />
                                    <ComboBoxItem Content="Superior derecha" Tag="top-right" />
                                    <ComboBoxItem Content="Inferior izquierda" Tag="bottom-left" />
                                    <ComboBoxItem Content="Inferior centro" Tag="bottom-center" />
                                    <ComboBoxItem Content="Inferior derecha" Tag="bottom-right" />
                                </ComboBox>
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="FontFamilyCombo"
                                    Header="Fuente"
                                    SelectedIndex="1"
                                    IsEnabled="{Binding IsOn, ElementName=FoliateToggle}"
                                    SelectionChanged="PreviewSelection_Changed">
                                    <ComboBoxItem Content="Segoe UI" Tag="Segoe UI" />
                                    <ComboBoxItem Content="Arial" Tag="Arial" />
                                    <ComboBoxItem Content="Aptos" Tag="Aptos" />
                                    <ComboBoxItem Content="Calibri" Tag="Calibri" />
                                    <ComboBoxItem Content="Times New Roman" Tag="Times New Roman" />
                                    <ComboBoxItem Content="Verdana" Tag="Verdana" />
                                    <ComboBoxItem Content="Georgia" Tag="Georgia" />
                                    <ComboBoxItem Content="Courier New" Tag="Courier New" />
                                </ComboBox>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Estilo" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ToggleButton
                                            x:Name="BoldButton"
                                            Width="40"
                                            Height="32"
                                            Content="B"
                                            FontWeight="Bold"
                                            ToolTipService.ToolTip="Negrita"
                                            IsEnabled="{Binding IsOn, ElementName=FoliateToggle}"
                                            Checked="PreviewToggle_Changed"
                                            Unchecked="PreviewToggle_Changed" />
                                        <ToggleButton
                                            x:Name="ItalicButton"
                                            Width="40"
                                            Height="32"
                                            Content="I"
                                            FontStyle="Italic"
                                            ToolTipService.ToolTip="Cursiva"
                                            IsEnabled="{Binding IsOn, ElementName=FoliateToggle}"
                                            Checked="PreviewToggle_Changed"
                                            Unchecked="PreviewToggle_Changed" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <NumberBox
                                    x:Name="FontSizeBox"
                                    Header="Tamaño (pt)"
                                    Value="8"
                                    Minimum="5.5"
                                    Maximum="30"
                                    SmallChange="0.5"
                                    SpinButtonPlacementMode="Compact"
                                    IsEnabled="{Binding IsOn, ElementName=FoliateToggle}"
                                    ValueChanged="PreviewNumber_ValueChanged" />
                                <NumberBox
                                    x:Name="FolioMarginXBox"
                                    Grid.Column="1"
                                    Header="Margen H (mm)"
                                    Value="10"
                                    Minimum="0"
                                    Maximum="60"
                                    SpinButtonPlacementMode="Compact"
                                    IsEnabled="{Binding IsOn, ElementName=FoliateToggle}"
                                    ValueChanged="PreviewNumber_ValueChanged" />
                                <NumberBox
                                    x:Name="FolioMarginYBox"
                                    Grid.Column="2"
                                    Header="Margen V (mm)"
                                    Value="6"
                                    Minimum="0"
                                    Maximum="60"
                                    SpinButtonPlacementMode="Compact"
                                    IsEnabled="{Binding IsOn, ElementName=FoliateToggle}"
                                    ValueChanged="PreviewNumber_ValueChanged" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Certificación al reverso" IsExpanded="False">
                        <StackPanel Padding="4,12,4,8" Spacing="10">
                            <ToggleSwitch
                                x:Name="CertifyToggle"
                                Header="Agregar certificación detrás de cada página"
                                IsOn="False" />
                            <Button
                                Content="Seleccionar PDF de certificación"
                                HorizontalAlignment="Left"
                                Click="SelectCertificate_Click"
                                IsEnabled="{Binding IsOn, ElementName=CertifyToggle}" />
                            <TextBlock
                                x:Name="CertificateFileText"
                                Text="Ningún archivo seleccionado"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Opacity="0.72" />
                            <TextBlock
                                Text="El PDF de certificación debe tener una sola página. Se insertará como P1 → Certificación → P2 → Certificación… y las hojas de certificación no recibirán folio."
                                TextWrapping="Wrap"
                                FontSize="12"
                                Opacity="0.62" />
                        </StackPanel>
                    </Expander>

                    <Button
                        x:Name="ProcessButton"
                        Content="Procesar PDFs"
                        HorizontalAlignment="Stretch"
                        Style="{ThemeResource AccentButtonStyle}"
                        Click="ProcessButton_Click" />

                    <ProgressRing
                        x:Name="ProcessingRing"
                        IsActive="False"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center" />

                    <InfoBar
                        x:Name="StatusBar"
                        IsOpen="False"
                        IsClosable="True" />
                </StackPanel>
            </ScrollViewer>

            <Border
                Grid.Column="2"
                Padding="16"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                VerticalAlignment="Top">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="Vista previa" FontWeight="SemiBold" FontSize="16" />
                        <TextBlock Text="Posición, fuente y estilo del folio" FontSize="12" Opacity="0.62" />
                    </StackPanel>

                    <Viewbox Stretch="Uniform" HorizontalAlignment="Center" MaxHeight="430">
                        <Border
                            x:Name="PreviewSheet"
                            Width="252"
                            Height="356"
                            Background="White"
                            BorderBrush="#C9C9C9"
                            BorderThickness="1">
                            <Grid x:Name="PreviewPage" Margin="0">
                                <StackPanel Margin="35,70,35,0" Spacing="7" Opacity="0.16" VerticalAlignment="Top">
                                    <Rectangle Height="7" Fill="#444444" />
                                    <Rectangle Height="5" Fill="#777777" />
                                    <Rectangle Height="5" Fill="#777777" />
                                    <Rectangle Height="5" Fill="#777777" />
                                    <Rectangle Height="5" Fill="#777777" Width="125" HorizontalAlignment="Left" />
                                    <Rectangle Height="14" Fill="Transparent" />
                                    <Rectangle Height="5" Fill="#777777" />
                                    <Rectangle Height="5" Fill="#777777" />
                                    <Rectangle Height="5" Fill="#777777" Width="155" HorizontalAlignment="Left" />
                                </StackPanel>

                                <TextBlock
                                    x:Name="PreviewFolioText"
                                    Foreground="#111111"
                                    Text="1&#x0a;UNO"
                                    FontSize="9"
                                    MaxWidth="220"
                                    TextWrapping="Wrap"
                                    TextAlignment="Right"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Margin="0,8,12,0" />
                            </Grid>
                        </Border>
                    </Viewbox>

                    <TextBlock
                        x:Name="PreviewHint"
                        Text="La vista previa representa el folio. El documento real conserva su contenido original."
                        TextWrapping="Wrap"
                        FontSize="12"
                        Opacity="0.62" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
